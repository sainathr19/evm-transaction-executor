# RPC endpoint per chain, named by chain id. Setting one enables that chain (ADR 0005).
# A comma-separated list sets a fallback order.
RPC_URL_31337=http://127.0.0.1:8545
# RPC_URL_11155111=https://…
# RPC_URL_84532=https://…

# Optional per-chain settings. Defaults: 2000 ms poll, stuck after 60000 ms, 500 gwei fee cap.
# POLL_INTERVAL_MS_84532=1000
# STUCK_AFTER_MS_84532=10000
# MAX_FEE_GWEI_84532=0.5

# Comma-separated private keys. Each key's address becomes a sender (ADR 0006).
# Placeholders only: never commit real keys.
SIGNER_PRIVATE_KEYS=0x<private-key>,0x<private-key>

# The API has no auth, so it listens on localhost unless told otherwise.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/executor.db
LOG_LEVEL=info
